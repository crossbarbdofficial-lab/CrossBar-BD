<div class="card">${S.exp.map(e=>`<div class="row"><span>${esc(e.cat)}${EX.includes(e.cat)?"":' <span class="tag">purano, profit-e nai</span>'}<br><span class="sm">${e.date} ${esc(e.note)}</span></span><span><b>${tk(e.amt)}</b> <button class="d" onclick="sure(this,()=>delE('${e.id}'))">×</button></span></div>`).join("")||'<div class="sm">No expenses recorded</div>'}</div>
<button onclick="dlCsv()">📥 Export Orders to Excel (CSV)</button>`}
if(tab=="ads"){h=`<div class="card"><div class="f"><input id="ad" type="date" value="${today()}"><input id="as" type="number" placeholder="Ad Spend (৳)"><input id="am" type="number" placeholder="Messages"><input id="ao" type="number" placeholder="Orders from Ads"></div><button onclick="addAd()">+ Add Ad Entry</button></div><div class="card"><div class="grid"><div><div class="k">Spend</div><b>${tk(c.spend)}</b></div><div><div class="k">Cost per Message</div><b>${c.am?tk(c.spend/c.am):"-"}</b></div></div>${S.ads.map(x=>`<div style="border-top:1px solid var(--b);padding:8px 0"><div class="row" style="border:0;padding:0"><span class="sm">${x.date}</span><button class="d" onclick="sure(this,()=>delAd('${x.id}'))">×</button></div><div class="grid5" style="grid-template-columns:repeat(3,1fr);margin-top:4px"><div><div class="k">Spend</div><input type="number" value="${x.spend}" onchange="setAd('${x.id}','spend',this.value)"></div><div><div class="k">Messages</div><input type="number" value="${x.msgs}" onchange="setAd('${x.id}','msgs',this.value)"></div><div><div class="k">Orders</div><input type="number" value="${x.ords}" onchange="setAd('${x.id}','ords',this.value)"></div></div></div>`).join("")}</div>`}
$("app").innerHTML=h}
try{const l=localStorage.getItem("cbd");if(l)S=JSON.parse(l)}catch(e){}
try{const i0=document.querySelector('link[rel="icon"]');document.getElementById("logo").src=i0.href}catch(e){}
applyTheme();
render();
(async()=>{try{const db=await claude.use("db");if(!db)return;doc=db.doc("crossbar/state");const s=await doc.get();if(s.exists){S=Object.assign({products:[],orders:[],ads:[],exp:[],pkg:{t:0,q:0}},JSON.parse(JSON.stringify(s.data())));render()}else if(S.products.length||S.orders.length)save();$("st").textContent="✓ synced"}catch(e){doc=null}})();
</script></body></html>